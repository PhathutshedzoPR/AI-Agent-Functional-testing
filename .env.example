# Copy to .env.local and fill in. Never commit .env.local.

# google | anthropic | openai | openrouter | nvidia | replay
LLM_PROVIDER=google
# A current model ID from your provider console (for Gemini, pick a Flash model in AI Studio)
LLM_MODEL=
# true saves every LLM response to fixtures/llm-replays
LLM_RECORD=false
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter and NVIDIA (build.nvidia.com) speak the OpenAI API; keys from their consoles.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Backups tried in order when the main model fails (overloaded, out of quota): provider:model,
# comma separated, with model ids from each provider's console. Each needs its key above, e.g.
# nvidia:moonshotai/kimi-k3,openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACKS=

APP_BASE_URL=http://localhost:3000
# allowlist | public
TARGET_MODE=allowlist
# Hosts a run may test. Add demo.playwright.dev to offer Playwright's TodoMVC demo on the new run page.
TARGET_ALLOWLIST=localhost:3000,demo.playwright.dev

AGENT_MAX_PAGES=5
AGENT_MAX_SCENARIOS=4
AGENT_MAX_STEPS=12
AGENT_MAX_LLM_CALLS=12
AGENT_STEP_TIMEOUT_MS=5000
AGENT_RUN_TIMEOUT_MS=180000
AGENT_HEAL_MIN_CONFIDENCE=0.7
AGENT_SNAPSHOT_MAX_CHARS=12000
AGENT_HEADLESS=true
# e.g. 250 with AGENT_HEADLESS=false to watch the real browser on stage
AGENT_SLOW_MO_MS=0

RATE_LIMIT_RUNS_PER_MINUTE=5
